# ============================================================
# Environment Configuration Template
# Copy to .env and fill in your API keys:  cp .env.example .env
# ============================================================

# ── LLM Configuration ───────────────────────────────────────
# The server provides a default AI service (GPT-5 mini) with a
# $5/month budget per company.  Users can add their own API key
# in Settings > AI Configuration for unlimited access.
#
# Set OPENAI_API_KEY here only if you want a server-level default.
# It is NOT required — the app works without it (users bring their own key).

# OpenAI (server default — optional)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_PROD_MODEL=gpt-5-mini-2025-08-07
# OPENAI_DEV_MODEL=gpt-5-mini-2025-08-07

# Anthropic (optional — for multi-provider BYOK validation)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini (optional)
# GOOGLE_API_KEY=your-key-here

# DeepSeek (optional)
# DEEPSEEK_API_KEY=your-key-here

# Mistral (optional)
# MISTRAL_API_KEY=your-key-here

# ── Ollama / Local LLM ─────────────────────────────────────
# For local AI or DGX server.  Users can also configure per-company
# endpoints in Settings > AI Configuration.
#
# Recommended chat model: qwen3:latest (5.2 GB, fast, tool-capable, clean output)
# Alternative reasoning model: qwq:32b (19 GB, emits <think> blocks, slower)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:latest
# Tool-capable Ollama model families: llama3.1, llama3.2, qwen2.5, qwen3,
# qwq, mistral-nemo, firefunction-v2, command-r, command-r-plus

# ── Embedding Models ───────────────────────────────────────────
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_MODEL_OPENAI=text-embedding-3-large
# EMBEDDING_MODEL_OLLAMA=mxbai-embed-large
# Self-hosted Ollama also needs: ollama pull mxbai-embed-large

# ── Default Model ───────────────────────────────────────────
# DEFAULT_LLM_MODEL=gpt-5-mini-2025-08-07

# ── LLM Key Encryption ─────────────────────────────────────
# Required in production.  Encrypts user-provided API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LLM_KEY_ENCRYPTION_KEY=

# ── Database ────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379/0

# ── Authentication ──────────────────────────────────────────
# JWT_SECRET_KEY=change-this-to-a-random-string-at-least-32-chars

# ── Application ─────────────────────────────────────────────
# APP_ENV=development
# DEBUG=true
# LOG_LEVEL=INFO
